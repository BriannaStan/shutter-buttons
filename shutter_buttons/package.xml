<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>shutter_buttons</name>
  <version>3.0.1</version>
  <description>ROS2 interfaces to Arduino arcade buttons with GUI</description>

  <maintainer email="a.lew@yale.edu">Sasha Lew</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>shutter_buttons_msgs</exec_depend>

  <exec_depend>micro_ros_agent</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
